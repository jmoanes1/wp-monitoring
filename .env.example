PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Monitoring interval in milliseconds. Default 15 minutes.
# Allowed values in Settings: 5m, 15m, 30m, 1h, 6h, 24h.
MONITOR_INTERVAL=900000

APP_TIMEZONE=Asia/Manila

JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=ChangeMeNow!

# Maximum HTTP response size when fetching monitored sites (bytes)
MAX_RESPONSE_BYTES=2097152

# Outbound request timeout when checking websites (ms)
REQUEST_TIMEOUT_MS=15000

# Email used in form fields during tests.
FORM_TEST_EMAIL=john@medisure.com
# Inbox for Playwright Real Test Submission reports.
FORM_TEST_REPORT_EMAIL=john@medishure.com

# Optional SMTP for Real Test Submission reports (leave empty to skip sending).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 64 hex characters (32 bytes) used to encrypt stored WordPress passwords.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Do not commit the real key. Leave empty in this example file.
CREDENTIALS_ENCRYPTION_KEY=
